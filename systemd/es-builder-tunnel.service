[Unit]
Description=ES-Builder Cloudflare Tunnel (temporário)
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
User=__USER__
WorkingDirectory=__WORKDIR__
ExecStart=/usr/local/bin/cloudflared tunnel --url http://localhost:80 --no-autoupdate
Restart=on-failure
RestartSec=15
StandardOutput=append:__WORKDIR__/logs/tunnel.log
StandardError=append:__WORKDIR__/logs/tunnel.log

[Install]
WantedBy=multi-user.target
