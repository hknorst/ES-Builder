# .env.example — variáveis de ambiente do es-builder
#
# Copie para .env e preencha os valores antes de iniciar.
# As variáveis específicas de cada projeto ficam em envs/projeto-x.env,
# gerados pelo setup.sh e ignorados pelo Git.

# Caminho para a chave SSH privada usada para clonar os repositórios
SERVER_SSH_KEY_PATH=~/.ssh/es-builder_ed25519
